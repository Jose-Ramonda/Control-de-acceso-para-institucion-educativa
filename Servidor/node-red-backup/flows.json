    {
        "id": "0eb47a548653b96b",
        "type": "function",
        "z": "8b51d57d1496e005",
        "name": "memset",
        "func": "let tpc = msg.topic.split(\"/\");\nlet cmd = tpc[2]; // Extrae \"abrir\" o \"foto\"\n\n// msg.payload es \"0x0A,987654321\"\nlet partes = msg.payload.split(\",\");\nlet nodo = partes[0];      // \"0x0A\"\nlet chat_id = partes[1];   // \"987654321\"\n\n// Creamos una clave única combinando el nodo y el comando\n// Ejemplo de clave resultante: \"0x0A_abrir\" o \"0x0A_foto\"\nlet claveMemoria = `${nodo}_${cmd}`;\n\n// Guardamos en la memoria del flujo el chat_id usando esa clave combinada\nflow.set(claveMemoria, chat_id);\n\nnode.log(`[NODE-RED] Registrado tracking: ${claveMemoria} pertenece al chat ${chat_id}`);\n\nreturn null; // Cortamos acá, no mandamos nada a Telegram todavía",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 320,
        "wires": [
            []
        ]
    },
    {
        "id": "3b96b305b1c25918",
        "type": "function",
        "z": "8b51d57d1496e005",
        "name": "armatrama-puerta",
        "func": "let nodo = msg.idNodo; \nlet claveMemoria = `${nodo}_abrir`;\n\n// Buscamos quién pidió la apertura en la RAM de Node-RED\nlet chat_id = flow.get(claveMemoria);\n\nif (chat_id) {\n    // Armamos la estructura JSON exacta del nuevo protocolo\n    msg.payload = {\n        \"destino\": parseInt(chat_id, 10),\n        \"evento\": \"puerta_ok\",\n        \"nodo\": nodo,\n        \"data\": \"\" // No requiere datos adicionales\n    };\n    \n    msg.topic = \"sbc/bot/notificaciones\";\n    \n    // Limpiamos la RAM de Node-RED\n    flow.set(claveMemoria, null); \n    \n    return msg; // Va al nodo 'mqtt out'\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 220,
        "wires": [
