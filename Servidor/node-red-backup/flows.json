    {
        "id": "b8404560455c064c",
        "type": "function",
        "z": "8b51d57d1496e005",
        "name": "armatrama-foto",
        "func": "let nodo = msg.idNodo; // \"0x14\"\nlet claveMemoria = `${nodo}_foto`;\n\n// Vamos a buscar a la RAM si alguien estaba esperando esta foto\nlet chat_id_solicitante = flow.get(claveMemoria);\n\nif (chat_id_solicitante) {\n    // CASO A: Había una ID esperando. Fue una foto SOLICITADA.\n    msg.payload = {\n        \"destino\": parseInt(chat_id_solicitante, 10),\n        \"evento\": \"foto_solicitada_ok\",\n        \"nodo\": nodo,\n        \"data\": `/home/jose/Proyecto/SBC/fotos/home/jose/Proyecto/SBC/fotos/captura_actual.jpeg`\n    };\n    \n    // Al encontrarlo, limpiamos la RAM para la próxima vuelta\n    flow.set(claveMemoria, null);\n} \nelse {\n    // CASO B: La RAM estaba vacía. Nadie la pidió -> Fue un TIMBRE FÍSICO espontáneo.\n    msg.payload = {\n        \"destino\": \"all\",\n        \"evento\": \"foto_espontanea_ok\",\n        \"nodo\": nodo,\n        \"data\": `/home/jose/Proyecto/SBC/fotos/captura_actual.jpeg` \n        // Nota: La ruta puede ser la misma porque el archivo se pisa con la última captura\n    };\n}\n\nmsg.topic = \"sbc/notify\";\nreturn msg; // Va directo al nodo 'mqtt out'",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 180,
        "wires": [
            [
                "c3efbcd0d04b3a4a"
            ]
        ]
    },
    {
        "id": "fcf5c0fa6fdf06d2",
        "type": "function",
        "z": "8b51d57d1496e005",
        "name": "guarda ip",
        "func": "// 1. Tomamos la IP limpia que pasó el switch\nlet ipNodo = msg.payload.toString().trim();\n\n// 2. Usamos el idNodo que inyectaste en el bloque anterior (ej: \"0x0A\")\nlet nodo = msg.idNodo; \n\n// 3. Guardamos en la RAM del flujo asociándolo al nodo\nlet claveMemoria = `${nodo}_ip`;\nflow.set(claveMemoria, ipNodo);\n\n// Imprimimos en la consola de Node-RED para verificar que se guardó bien\nnode.warn(`💾 IP Registrada en RAM -> Acceso: ${nodo} | IP: ${ipNodo}`);\n\n// Retornamos el mensaje por si querés conectar un nodo de Debug al final\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 280,
        "wires": [
            []
        ]
    },
    {
