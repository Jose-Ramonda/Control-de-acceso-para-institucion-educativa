    {
        "id": "fca45853596c816d",
        "type": "function",
        "z": "3c1d4f51b7b9fca4",
        "name": "CRC",
        "func": "let startByte = msg.payload[0];\nlet data = Buffer.from(msg.payload.slice(1)); \n\n// 1. Inicialización: crc = (~0xFFFF) & 0xFFFF -> que es 0x0000\nlet crc = (~0xFFFF) & 0xFFFF;\n\n// 2. Bucle principal\nfor (let pos = 0; pos < data.length; pos++) {\n    crc ^= data[pos];\n    \n    for (let i = 0; i < 8; i++) {\n        if ((crc & 1) !== 0) {\n            crc = (crc >> 1) ^ 0x8408;\n        } else {\n            crc >>= 1;\n        }\n        crc &= 0xFFFF; // Mantenemos en 16 bits\n    }\n}\n\n// 3. Inversión final: (~crc) & 0xFFFF\ncrc = (~crc) & 0xFFFF;\n\n// 4. Empaquetar todo (Start + Data + CRC_Low + CRC_High)\nlet startBuf = Buffer.from([startByte]);\nlet crcBuf = Buffer.alloc(2);\ncrcBuf.writeUInt16LE(crc, 0); // LE igual que en el ESP32\n\nmsg.payload = Buffer.concat([startBuf, data, crcBuf]);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
