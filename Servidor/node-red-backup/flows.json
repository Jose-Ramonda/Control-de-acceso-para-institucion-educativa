    {
        "id": "7622fc0613a72010",
        "type": "function",
        "z": "3c1d4f51b7b9fca4",
        "name": "function 1",
        "func": "// Si el mensaje tiene payload, lo formateamos en HEX legible\nif (msg.payload) {\n    let buffer;\n    \n    // Convertir a Buffer si viene como array o string\n    if (Buffer.isBuffer(msg.payload)) {\n        buffer = msg.payload;\n    } else if (Array.isArray(msg.payload)) {\n        buffer = Buffer.from(msg.payload);\n    } else {\n        buffer = Buffer.from(msg.payload.toString());\n    }\n\n    // Convertir cada byte a formato Hex (ej: \"AA AA 00 07 00 F7 B2\")\n    let hexString = buffer.toString('hex').toUpperCase().match(/.{1,2}/g).join(' ');\n\n    // Creamos una propiedad limpia para ver en el panel de Debug\n    msg.payload_hex = hexString;\n    \n    // O si preferís sustituir el payload directo para la consola:\n    msg.payload = hexString;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
